.env
*.env
*.key
.DS_Store
.claude/settings.local.json
node_modules/

# Client reference/creative images: kept local only, never pushed to this
# public repo (bloat + visibility risk — see README's "Where GoMedia's data
# comes from"). Each ad-references folder keeps an index.md describing what's
# there; that travels through git, the binaries don't.
clients/*/inputs/**/*.jpg
clients/*/inputs/**/*.jpeg
clients/*/inputs/**/*.png
clients/*/inputs/**/*.webp
clients/*/inputs/**/*.gif
!clients/*/inputs/**/index.md

# Generated / downloaded creative (images, video, audio) in campaign and
# project folders: local only, same reason as above. The .md prompts, copy and
# SOURCES.md files travel through git.
clients/*/campaigns/**/*.png
clients/*/campaigns/**/*.jpg
clients/*/campaigns/**/*.jpeg
clients/*/campaigns/**/*.webp
clients/*/campaigns/**/*.mp4
clients/*/campaigns/**/*.mp3
clients/*/campaigns/**/*.wav
clients/*/projects/**/*.png
clients/*/projects/**/*.jpg
clients/*/projects/**/*.jpeg
clients/*/projects/**/*.webp
clients/*/projects/**/*.mp4
clients/*/projects/**/*.mp3
# Large example videos bundled with vendored skills
.claude/skills/**/*.mp4

# My Office (3D office for Claude Code sessions): local tool only, never
# commit or push it — too heavy for this repo and for teammates to install.
# Source: https://github.com/khanh020905/my-office
vendor/my-office/

# Local Netlify folder
.netlify

# Dashboard secrets (links to private client data) - keep local, repo is public
dashboards/netlify/clients.mjs
dashboards/agent-links.csv
dashboards/account-review.csv
dashboards/netlify/alerts-page.mjs
