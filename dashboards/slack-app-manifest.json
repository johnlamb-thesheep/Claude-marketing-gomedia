{
  "display_information": {
    "name": "GoMedia Ad Alerts",
    "description": "Daily Meta ad opportunities, creative fatigue and low-CTR alerts",
    "background_color": "#1f2937"
  },
  "features": {
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    },
    "bot_user": {
      "display_name": "Ad Alerts",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/adreport",
        "url": "https://gomedia-ads-dash-26798.netlify.app/api/slack/adreport",
        "description": "Latest ad opportunities, fatigue and low-CTR report",
        "usage_hint": "[opps | fatigue | ctr | trade | goahead | daily]",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": ["chat:write", "commands"]
    }
  },
  "settings": {
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
